{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lawyeah Domain Skill Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "description",
    "version",
    "license",
    "jurisdiction",
    "entrypoint",
    "contentModel",
    "reinstallStrategy",
    "mcp"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "displayName": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "license": {"const": "Apache-2.0"},
    "jurisdiction": {"const": "CN-mainland"},
    "entrypoint": {"const": "SKILL.md"},
    "contentModel": {"const": "progressive-disclosure"},
    "reinstallStrategy": {"const": "replace"},
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "capabilities"],
      "properties": {
        "contractVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "capabilities": {"$ref": "mcp-capabilities.schema.json"}
      }
    }
  }
}
