{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lawyeah MCP Decision-Node Dependency",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "purpose", "capability", "level", "unavailableBehavior"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "purpose": {"type": "string", "minLength": 1},
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "level": {"enum": ["required", "recommended", "optional"]},
    "unavailableBehavior": {"type": "string", "minLength": 1}
  }
}
